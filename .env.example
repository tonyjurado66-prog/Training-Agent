# Copiez ce fichier en .env puis renseignez vos valeurs.

# Clé API Anthropic (https://console.anthropic.com) — obligatoire.
ANTHROPIC_API_KEY=sk-ant-...

# Port HTTP du serveur.
PORT=3000

# Modèle Claude et niveau d'effort (low | medium | high | xhigh | max).
TA_MODEL=claude-opus-5
TA_EFFORT=medium

# Jeton protégeant l'édition des formations depuis le studio.
# Laissé vide : édition autorisée uniquement depuis http://localhost sur la machine du serveur.
ADMIN_TOKEN=

# Sites autorisés à intégrer le widget, séparés par des virgules (ex. https://www.mon-site.fr).
# « * » = tous les sites (pratique en test, à restreindre en production).
ALLOWED_ORIGINS=*

# Nombre maximal de messages par minute et par adresse IP.
RATE_LIMIT_PER_MIN=30

# Dossier des formations (fichiers .json).
# COURSES_DIR=./courses
